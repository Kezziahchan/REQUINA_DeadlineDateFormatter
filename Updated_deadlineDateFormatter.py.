
# Version 2: Deadline and Date Formatter

from datetime import datetime

# Ask for event details
event_title = input("Enter event title: ").strip()
year = int(input("Enter year: "))
month = int(input("Enter month: "))
day = int(input("Enter day: "))

# Create and format date
event_date = datetime(year, month, day)

# Display formatted output
print("\nFormatted Output:")
print("Event:", event_title.upper())
print("Date:", event_date.strftime("%B"), event_date.day, ",", event_date.year)
print("Year:", event_date.year)
print("Month:", event_date.strftime("%B"))
print("Day:", event_date.day)
print("Weekday:", event_date.strftime("%A"))
